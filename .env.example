# ─────────────────────────────────────────────────────────────────────
# تعمیرآنلاین — نمونه‌ی کامل تنظیمات محیط
# این فایل را به .env کپی کنید و مقادیر واقعی را پر کنید.
# هرگز .env واقعی را commit نکنید.
# ─────────────────────────────────────────────────────────────────────

# ─── اپلیکیشن ────────────────────────────────────────────────────────
APP_NAME="تعمیرآنلاین"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tehran
APP_URL=http://localhost:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

# ─── لاگ ─────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ─── دیتابیس اصلی ────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tamironline_crm
DB_USERNAME=root
DB_PASSWORD=

# ─── دیتابیس WP قدیمی (CRM) — برای php artisan crm:import ───────────
# همان MySQL سرور؛ فقط نام دیتابیس وردپرسی را وارد کنید
LEGACY_WP_DB_HOST=127.0.0.1
LEGACY_WP_DB_PORT=3306
LEGACY_WP_DB_DATABASE=
LEGACY_WP_DB_USERNAME=
LEGACY_WP_DB_PASSWORD=
LEGACY_WP_DB_PREFIX=wp_

# ─── دیتابیس WP بلاگ — برای php artisan blog:import-from-wp ─────────
# انتقال مقالات + تصاویر (همیشه با --download-images اجرا کنید).
# WP_BLOG_SITE_URL آدرس سایت قدیم وردپرس است (برای original_url مقالات).
WP_BLOG_DB_HOST=127.0.0.1
WP_BLOG_DB_PORT=3306
WP_BLOG_DB_NAME=
WP_BLOG_DB_USER=
WP_BLOG_DB_PASS=
WP_BLOG_DB_PREFIX=wp_
WP_BLOG_SITE_URL=https://tamironline.com

# ─── دیتابیس WP (سینک دوطرفه CRM↔WP) ────────────────────────────────
WP_DB_HOST=127.0.0.1
WP_DB_PORT=3306
WP_DB_NAME=
WP_DB_USER=
WP_DB_PASS=
WP_DB_PREFIX=wp_

# Push تغییرات CRM به WP (observer) — فقط وقتی WP هنوز فعال است true کنید
CRM_WP_PUSH_ENABLED=false

# ─── دیتابیس Backup (گزارش/مقایسه) ──────────────────────────────────
BACKUP_DB_HOST=127.0.0.1
BACKUP_DB_PORT=3306
BACKUP_DB_DATABASE=
BACKUP_DB_USERNAME=
BACKUP_DB_PASSWORD=

# ─── Session / Cache / Queue ─────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ─── پیامک کاوه‌نگار ─────────────────────────────────────────────────
# SMS_DRIVER: kavenegar | log (حالت log فقط در لاگ می‌نویسد — برای dev)
SMS_DRIVER=kavenegar
SMS_KAVENEGAR_API_KEY=
SMS_KAVENEGAR_SENDER=
SMS_OTP_EXPIRE_MINUTES=2
SMS_OTP_RESEND_SECONDS=60
SMS_OTP_MAX_ATTEMPTS=5

# پروکسی SMS (اگر سرور به کاوه‌نگار دسترسی مستقیم ندارد)
SMS_PROXY_ENABLED=false
SMS_PROXY_URL=
SMS_PROXY_SECRET=

# نام template های کاوه‌نگار (lookup) — در پنل کاوه‌نگار تعریف شوند
SMS_TEMPLATE_OTP=
SMS_TEMPLATE_WELCOME=
SMS_TEMPLATE_NEW_INVOICE=
SMS_TEMPLATE_PAYMENT_REMINDER=
SMS_TEMPLATE_SERVICE_EXPIRY=
SMS_TEMPLATE_SERVICE_RENEWED=
SMS_TEMPLATE_TICKET_REPLY=

# ─── Laravel Reverb (WebSocket — چت/نوتیف لحظه‌ای) ──────────────────
REVERB_APP_ID=tamironline
REVERB_APP_KEY=tamironline-key
REVERB_APP_SECRET=tamironline-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─── API داخلی (Next BFF → Laravel) ─────────────────────────────────
# حداقل ۴۸ بایت رندوم:  php artisan tinker  ›  bin2hex(random_bytes(48))
INTERNAL_API_TOKEN=
# برای rotation بدون downtime (اختیاری)
INTERNAL_API_TOKEN_OLD=

# Webhook revalidate به فرانت Next.js (بعد از تغییر بنر/مقاله/...)
SITE_REVALIDATION_URL=
SITE_REVALIDATION_SECRET=

# ─── اپلیکیشن مشتریان (CustomerApp) ─────────────────────────────────
# Sanctum — عمر توکن اپ موبایل به دقیقه (پیش‌فرض ۳۰ روز)
SANCTUM_TOKEN_EXPIRATION=43200

# Originهای مجاز CORS برای /v1/customer/* (با کاما جدا کنید)
CUSTOMER_APP_ORIGINS=

# وضعیت اپ (قابل override از پنل ادمین → مدیریت اپلیکیشن → تنظیمات اپ)
APP_DISABLED=false
APP_MIN_VERSION=1.0.0
APP_LATEST_VERSION=1.0.0
APP_MAINTENANCE_ACTIVE=false
APP_MAINTENANCE_MESSAGE=
# timestamp یونیکس — توکن‌های قدیمی‌تر logout اجباری می‌شوند (0 = غیرفعال)
APP_FORCE_REAUTH_AT=0

# حالت تست QA — فقط در staging! OTP ثابت برای شماره‌های تست
CUSTOMER_APP_TEST_MODE=false
CUSTOMER_APP_TEST_OTP=
# شماره‌های تست با کاما (مثلاً 09120000001,09120000002)
CUSTOMER_APP_TEST_MOBILES=

# ─── نقشه نشان (neshan.org) — platform.neshan.org ───────────────────
# NESHAN_WEB_KEY: کلید «Web» برای نمایش نقشه (SDK لیفلت — اپ + پنل ادمین)
# NESHAN_SERVICE_KEY: کلید «Service/REST» با دسترسی «تبدیل نقطه به آدرس»
#                     (فقط سمت سرور می‌ماند — از طریق proxy به اپ سرویس داده می‌شود)
NESHAN_WEB_KEY=
NESHAN_SERVICE_KEY=
NESHAN_BASE_URL=https://api.neshan.org

# ─── سایر سرویس‌ها ───────────────────────────────────────────────────
# زیردامنه‌ی پنل تکنسین‌ها
TECH_SUBDOMAIN=

# زحل (سرویس خارجی)
ZOHAL_BASE_URL=
ZOHAL_API_TOKEN=



