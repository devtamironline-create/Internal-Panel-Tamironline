APP_NAME="تعمیرآنلاین"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tehran
APP_URL=http://localhost:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tamironline_crm
DB_USERNAME=root
DB_PASSWORD=

# Legacy WordPress CRM database — for php artisan crm:import
# همان MySQL سرور؛ فقط نام دیتابیس وردپرسی را وارد کنید
LEGACY_WP_DB_HOST=127.0.0.1
LEGACY_WP_DB_PORT=3306
LEGACY_WP_DB_DATABASE=
LEGACY_WP_DB_USERNAME=
LEGACY_WP_DB_PASSWORD=
LEGACY_WP_DB_PREFIX=wp_

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Kavenegar SMS
SMS_KAVENEGAR_API_KEY=
SMS_KAVENEGAR_SENDER=
SMS_OTP_EXPIRE_MINUTES=2
SMS_OTP_RESEND_SECONDS=60

# Laravel Reverb (WebSocket)
REVERB_APP_ID=tamironline
REVERB_APP_KEY=tamironline-key
REVERB_APP_SECRET=tamironline-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# API داخلی (Next BFF → Laravel) — حداقل ۴۸ بایت رندوم
# php artisan tinker  ›  bin2hex(random_bytes(48))
INTERNAL_API_TOKEN=e6f098150e8a30cc0c78e8e1cc13b383296c4eacba9986d2abba782d6d4a34d41fe694a2ad163083c8e9ff2ea47f8d2e
# برای rotation بدون downtime (اختیاری)
INTERNAL_API_TOKEN_OLD=
